# Debrief environment configuration.
# Copy to .env and fill in. ALL SOURCES ARE FREE.

# REQUIRED — GitHub Personal Access Token (raises API limit 60 -> 5000 req/hr).
# Powers the GitHub-implementation in-field signal. Create a classic token with NO
# scopes (public search needs none): https://github.com/settings/tokens
GITHUB_PAT=

# RECOMMENDED — Semantic Scholar API key (free, instant; eases rate limits).
# Request at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Bluesky (researcher-chatter in-field signal). Your handle + an APP PASSWORD
# (not your account password). Create one at https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ----- Fast-follow (not needed for v1) -----
# Reddit app (r/LocalLLaMA, r/MachineLearning) — register at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=debrief/0.1
#
# OpenAlex (trend layer, later) — free key (~2026 requirement)
# OPENALEX_API_KEY=

# =====================================================================
#  DO NOT SET ANTHROPIC_API_KEY.
#  Debrief runs on your Claude Max subscription via Claude Code subagents.
#  An ANTHROPIC_API_KEY in the environment silently switches to paid
#  per-token billing. The /debrief command checks for it and warns you.
# =====================================================================
