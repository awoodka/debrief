# Debrief's collector environment. Copy to .env (mode 600) and fill in. scripts/dev passes it to
# collector commands; on the server, deploy/run.sh reads /srv/apps/debrief-v2/.env.

# A GitHub token for the GitHub API sources (5,000 requests an hour instead of 60). A fine-grained
# token with no permissions beyond public read is enough.
GITHUB_PAT=

# An email for the User-Agent; some APIs ask for a contact.
DEBRIEF_CONTACT=

# Never set ANTHROPIC_API_KEY, here or in the Claude token file. Triage and the brief run on the
# Claude Max plan through Claude Code, and an API key would silently switch them to paid API use;
# deploy/run.sh refuses to start if it finds one. The Claude token lives in its own file
# (/srv/apps/debrief-v2/claude.env), which only the steps that call Claude get.
