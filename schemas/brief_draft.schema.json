{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awoodka/debrief/schemas/brief_draft.schema.json",
  "title": "runs/<date>/brief.draft.json",
  "description": "What the brief skill writes. Prose fields hold no URLs and no story ids: links and story details are attached by `debrief brief finalize` from the triage data, which writes brief.json (brief.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "headline", "what_happened", "lead", "sections"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "headline": {"type": "string", "minLength": 10, "maxLength": 160,
                 "description": "The day in one event-first line."},
    "what_happened": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "description": "The 5-second scan: concrete events, one clause each, news language, no interpretation.",
      "items": {"$ref": "#/$defs/event"}
    },
    "lead": {"type": "string", "minLength": 1,
             "description": "2-4 paragraphs (blank lines between them): the day's through-line."},
    "sections": {
      "type": "array", "minItems": 1,
      "description": "The article, woven by theme, in reading order.",
      "items": {"$ref": "#/$defs/section"}
    },
    "updates": {
      "type": "array",
      "description": "Follow-ups on stories from earlier briefs: what's new since.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["story", "text"],
        "properties": {"story": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "notes": {
      "type": "array", "items": {"type": "string", "minLength": 1},
      "description": "Gaps worth saying: a source down, thin evidence, a quiet day."
    },
    "fetch_notes": {
      "type": "object", "additionalProperties": {"type": "string", "minLength": 1},
      "description": "url -> why it was fetched. The fetch log is the record; these explain it."
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3},
    "event": {
      "type": "object", "additionalProperties": false, "required": ["text", "stories"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "stories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["heading", "body", "stories"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "stories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "split": {
          "type": "object", "additionalProperties": false, "required": ["for", "against", "read"],
          "description": "Only for a genuinely two-sided call.",
          "properties": {"for": {"type": "string", "minLength": 1}, "against": {"type": "string", "minLength": 1},
                         "read": {"type": "string", "minLength": 1}}
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["story", "text"],
            "properties": {"story": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
